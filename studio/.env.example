# --- Required ---
# 32-byte key (hex or base64) used to encrypt provider API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Secret used to sign session cookies and signed file URLs (min 32 chars)
SESSION_SECRET=
# Public base URL of the app (used by the render worker to fetch assets)
APP_URL=http://localhost:3000

# --- Database (optional; defaults to a local JSON file store in ./storage/db) ---
# Works with any PostgreSQL, including Supabase (Project Settings -> Database -> Connection string)
DATABASE_URL=

# --- Render queue (optional; without it a durable file-based queue is used) ---
REDIS_URL=

# --- File storage (optional; defaults to ./storage/files) ---
# Supabase Storage: set both to store uploads/renders in a private bucket
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ad-studio

# Chromium used by the Remotion renderer (optional; Remotion downloads its own headless shell if empty)
REMOTION_BROWSER_EXECUTABLE=
# OpenGL backend for 3D scenes during rendering: angle | swangle | egl | swiftshader
REMOTION_GL=angle
