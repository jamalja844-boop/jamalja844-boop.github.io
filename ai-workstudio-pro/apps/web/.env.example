# ─────────────────────────────────────────────────────────────────────────────
# AI WorkStudio Pro – configuratie (apps/web)
# Kopieer naar .env en vul in. Zet NOOIT echte sleutels in de broncode of in Git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 15+ met pgvector (lokaal, Docker of Supabase).
# Supabase: Project Settings → Database → Connection string (URI). Gebruik bij de
# transaction pooler (poort 6543) ook DATABASE_PREPARE=false.
DATABASE_URL=postgres://studio:studio@localhost:5432/ai_studio
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# Publieke URL van de applicatie (https in productie → beveiligde __Host- cookies).
APP_URL=http://localhost:3000

# 32 willekeurige bytes (base64) voor AES-256-GCM-versleuteling van API-sleutels.
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bewaar deze sleutel veilig: zonder deze sleutel zijn opgeslagen API-sleutels onleesbaar.
APP_ENCRYPTION_KEY=

# Sessieduur in uren (standaard 7 dagen).
SESSION_TTL_HOURS=168

# Open registratie toestaan (false = alleen eerste installatie + uitnodigingen).
ALLOW_SIGNUP=false

# Demo-simulator (geen echte AI, duidelijk gemarkeerd) voor testen zonder API-sleutels.
# In productie uitzetten.
ENABLE_DEMO_PROVIDER=true

# Optioneel: server-brede AI-sleutels. Voorkeur: per workspace instellen via
# Instellingen → AI-providers (versleuteld opgeslagen in de database).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Server-side refusal-fallback voor Claude-modellen (beta). Zet op false als je account dit niet ondersteunt.
ANTHROPIC_REFUSAL_FALLBACK=true

# Optioneel: Google Workspace-koppeling (Gmail, Agenda, Drive) via OAuth.
# Redirect-URI in Google Cloud Console: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploadlimiet voor kennisbankdocumenten (MB) en parallelle worker-taken.
MAX_UPLOAD_MB=20
WORKER_CONCURRENCY=2
# true = job-worker draait in het webproces (handig voor één container / lokaal met `npm start`).
# Bij `npm run dev` draait de worker al apart; zet dit dan op false.
RUN_WORKER_IN_WEB=false

# ── AI Code ────────────────────────────────────────────────────────────────────
# Map waarin elk project een eigen werkmap krijgt: <WORKSPACE_ROOT>/<org-id>/<project-id>.
# Standaard: ./.workspaces binnen apps/web. Gebruik in productie een apart volume.
WORKSPACE_ROOT=
# Commando's en tests draaien in een Docker-container (geen netwerk, geen rechten,
# alleen-lezen systeem, limieten). De server moet Docker kunnen gebruiken.
SANDBOX_IMAGE=node:22-alpine
SANDBOX_TIMEOUT_MS=180000
SANDBOX_MEMORY_MB=1536
SANDBOX_CPUS=1
# true = HTTP(S)_PROXY van de server doorgeven aan installatiecommando's (alleen na toestemming).
SANDBOX_PASS_PROXY=false
# Hosts waarvan openbare Git-repository's (https) gekloond mogen worden.
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
# Maximale actieve duur van één AI Code-taak (minuten).
CODE_TASK_MAX_MINUTES=20

# Seed (npm run db:seed): eerste beheerder als die nog niet bestaat.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Beheerder
