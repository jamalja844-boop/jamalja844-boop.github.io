# Copy to .env and fill in. Never commit the real .env.

# --- Assistant identity ---
COMPANY_NAME=Mijn Bedrijf
ASSISTANT_NAME=Sam
LANGUAGE=nl-NL
OPENING_HOURS=ma-vr 9:00-17:00
ADDRESS=
FAQ=
HUMAN_TRANSFER_NUMBER=      # optional, E.164 e.g. +31201234567

# --- LLM ---
LLM_PROVIDER=anthropic       # anthropic | openai
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=             # optional, for OpenAI-compatible endpoints

# --- TTS ---
TTS_PROVIDER=twilio          # twilio (no setup) | cartesia (recommended, natural) | elevenlabs
TWILIO_VOICE=Polly.Lotte-Neural
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Server ---
# Needed only for cartesia/elevenlabs so Twilio can fetch generated audio.
PUBLIC_BASE_URL=             # e.g. https://your-subdomain.ngrok.io
PORT=8080
