{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "shopify-ai-toolkit@claude-plugins-official": true
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "mcp__Metricool_Social_Media_Management__createScheduledPost",
      "mcp__Metricool_Social_Media_Management__createScheduledPostForReview",
      "mcp__Metricool_Social_Media_Management__updateScheduledPost",
      "mcp__Metricool_Social_Media_Management__sendScheduledPostForReview",
      "mcp__Shopify__theme_publish",
      "mcp__Shopify__theme_commit",
      "mcp__Shopify__graphql_mutation",
      "mcp__Shopify__bulk-update-product-status",
      "mcp__Shopify__create-discount",
      "mcp__Shopify__set-inventory",
      "mcp__Shopify__publish-digital-product",
      "mcp__Shopify__create-collection",
      "mcp__Shopify__update-collection",
      "mcp__Shopify__add-to-collection",
      "mcp__Shopify__create_store",
      "mcp__Shopify__upload_file",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__copy_file",
      "mcp__github__push_files",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file",
      "mcp__github__create_or_update_file",
      "mcp__Supermetrics_Marketing_Analytics__manage_campaign",
      "mcp__Supermetrics_Marketing_Analytics__manage_social_media",
      "mcp__Supermetrics_Marketing_Analytics__activation_audience_create",
      "mcp__Supermetrics_Marketing_Analytics__manage_activation_query",
      "mcp__kloudboard__publish_post",
      "mcp__kloudboard__buy_credits",
      "mcp__firecrawl__people_company_enrich",
      "mcp__firecrawl__firecrawl_agent",
      "mcp__floot__publish_app",
      "mcp__Picsart_Media_Studio__picsart_drive_delete",
      "mcp__Openart__openart_library_delete",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "CronCreate",
      "CronDelete",
      "Bash(git push *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(curl * -X POST *)",
      "Bash(curl * --data *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*.json)"
    ]
  },
  "env": {
    "TZ": "Europe/Amsterdam"
  }
}
