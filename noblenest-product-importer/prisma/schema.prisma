// Noblenest — databaseschema (PostgreSQL)
//
// Ontwerpprincipes:
// - Alle winkelgegevens hangen aan `Shop` en worden per winkel geautoriseerd (shopId in elke query).
// - Externe leveranciers-ID's (externalId) en Shopify-ID's (shopifyProductId) staan in aparte kolommen/tabellen.
// - Oorspronkelijke leveranciersgegevens (title, descriptionHtml, rawData) worden nooit overschreven door AI;
//   AI-teksten staan in eigen velden (ai*, seo*).
// - Geheimen (API-sleutels) worden uitsluitend versleuteld opgeslagen (AES-256-GCM, zie app/lib/security).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify-sessies (beheerd door @shopify/shopify-app-session-storage-prisma)
// ---------------------------------------------------------------------------

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Winkel en gebruikers
// ---------------------------------------------------------------------------

model Shop {
  id             String    @id @default(cuid())
  shopDomain     String    @unique
  name           String?
  currencyCode   String?
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users               User[]
  supplierConnections SupplierConnection[]
  supplierProducts    SupplierProduct[]
  productMappings     ShopifyProductMapping[]
  importJobs          ImportJob[]
  syncJobs            SyncJob[]
  pricingRules        PricingRule[]
  aiJobs              AIJob[]
  auditLogs           AuditLog[]
  settings            AppSetting[]
}

model User {
  id            String   @id @default(cuid())
  shopId        String
  shopifyUserId String
  email         String?
  firstName     String?
  lastName      String?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  auditLogs  AuditLog[]
  importJobs ImportJob[]

  @@unique([shopId, shopifyUserId])
}

// ---------------------------------------------------------------------------
// Leveranciers
// ---------------------------------------------------------------------------

enum SupplierType {
  API
  FEED
  FILE
  MANUAL
  SHOPIFY
}

/// Of er een echte, toegestane koppeling bestaat. Nooit "AVAILABLE" zetten zonder werkende adapter.
enum IntegrationStatus {
  AVAILABLE
  REQUIRES_CREDENTIALS
  REQUIRES_APPROVAL
  NOT_AVAILABLE
  PLANNED
}

model Supplier {
  id                String            @id @default(cuid())
  key               String            @unique
  name              String
  type              SupplierType
  integrationStatus IntegrationStatus
  website           String?
  description       String
  /// Ondersteunde functies van de adapter, bv. { "products": true, "stock": false }
  capabilities      Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  connections      SupplierConnection[]
  products         SupplierProduct[]
  pricingRules     PricingRule[]
  syncJobs         SyncJob[]
}

enum ConnectionStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
  DISCONNECTED
}

model SupplierConnection {
  id                   String           @id @default(cuid())
  shopId               String
  supplierId           String
  /// Naam van de koppeling, bv. "Linnenhuis feed" (meerdere feeds per leverancierstype mogelijk)
  name                 String           @default("")
  status               ConnectionStatus @default(NOT_CONFIGURED)
  /// Versleutelde JSON met credentials of feed-URL (nooit in platte tekst; URL's bevatten vaak tokens).
  credentialsEncrypted String?
  /// Niet-geheime instellingen, bv. { format, label, imageRights, host, productCount }
  config               Json?
  lastCheckedAt        DateTime?
  lastError            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([shopId, supplierId, name])
  @@index([shopId])
}

// ---------------------------------------------------------------------------
// Leveranciersproducten (bron) — gescheiden van Shopify-producten
// ---------------------------------------------------------------------------

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum SupplierProductStatus {
  NEW
  IMPORTED
  ARCHIVED
}

model SupplierProduct {
  id                String                @id @default(cuid())
  shopId            String
  supplierId        String
  /// ID van het product bij de leverancier (of uit de CSV-kolom external_id).
  externalId        String
  sourceUrl         String?
  /// Oorspronkelijke leveranciersgegevens — worden nooit door AI overschreven.
  title             String
  descriptionHtml   String?
  vendor            String?
  brand             String?
  productType       String?
  tags              String[]
  gtin              String?
  currencyCode      String                @default("EUR")
  costPrice         Decimal?              @db.Decimal(12, 4)
  shippingCost      Decimal?              @db.Decimal(12, 4)
  deliveryDaysMin   Int?
  deliveryDaysMax   Int?
  stockStatus       StockStatus           @default(UNKNOWN)
  safetyInfo        String?
  euResponsiblePerson String?
  countryOfOrigin   String?
  /// Volledige oorspronkelijke bronregel(s), ongewijzigd.
  rawData           Json
  /// AI-verbeterde teksten (afzonderlijk van de bron).
  aiTitle           String?
  aiDescriptionHtml String?
  seoTitle          String?
  seoDescription    String?
  /// Uitkomst van de kwaliteits-/regelgevingscontrole (lijst met waarschuwingen).
  complianceFlags   Json?
  status            SupplierProductStatus @default(NEW)
  lastSeenAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  shop     Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]
  mapping  ShopifyProductMapping?
  aiJobs   AIJob[]
  jobItems ImportJobItem[]

  @@unique([shopId, supplierId, externalId])
  @@index([shopId, sourceUrl])
  @@index([shopId, status])
}

model ProductVariant {
  id                String      @id @default(cuid())
  supplierProductId String
  externalId        String
  sku               String?
  barcode           String?
  /// [{ "name": "Kleur", "value": "Zwart" }]
  options           Json
  costPrice         Decimal?    @db.Decimal(12, 4)
  stockQuantity     Int?
  stockStatus       StockStatus @default(UNKNOWN)
  weightGrams       Int?
  imageSourceUrl    String?
  position          Int         @default(0)
  shopifyVariantId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, externalId])
}

enum ImageRightsStatus {
  UNVERIFIED
  CONFIRMED_BY_SUPPLIER
  CONFIRMED_BY_MERCHANT
  REJECTED
}

model ProductImage {
  id                String            @id @default(cuid())
  supplierProductId String
  sourceUrl         String
  altText           String?
  aiAltText         String?
  position          Int               @default(0)
  width             Int?
  height            Int?
  rightsStatus      ImageRightsStatus @default(UNVERIFIED)
  importedToShopify Boolean           @default(false)
  createdAt         DateTime          @default(now())

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, sourceUrl])
}

// ---------------------------------------------------------------------------
// Koppeling bronproduct ⇄ Shopify-product
// ---------------------------------------------------------------------------

model ShopifyProductMapping {
  id                String    @id @default(cuid())
  shopId            String
  supplierProductId String    @unique
  shopifyProductId  String
  shopifyHandle     String?
  /// Momentopname van de Shopify-status (DRAFT/ACTIVE/ARCHIVED) bij laatste controle.
  shopifyStatus     String    @default("DRAFT")
  /// Waarde van het metafield $app.source_id in Shopify (leverancier:externalId).
  sourceKey         String
  sellingPrice      Decimal?  @db.Decimal(12, 2)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyProductId])
  @@unique([shopId, sourceKey])
}

// ---------------------------------------------------------------------------
// Importtaken
// ---------------------------------------------------------------------------

enum ImportJobType {
  CSV
  XML
  JSON
  URL
  URL_BATCH
  MANUAL
}

enum ImportJobStatus {
  PREVIEW
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model ImportJob {
  id             String          @id @default(cuid())
  shopId         String
  createdById    String?
  type           ImportJobType
  status         ImportJobStatus @default(PREVIEW)
  sourceName     String
  supplierKey    String
  totalItems     Int             @default(0)
  succeededItems Int             @default(0)
  failedItems    Int             @default(0)
  skippedItems   Int             @default(0)
  /// Parseerfouten per regel: [{ row, message }]
  parseErrors    Json?
  imageRightsConfirmed Boolean   @default(false)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     ImportJobItem[]

  @@index([shopId, createdAt])
}

enum ImportItemStatus {
  PENDING
  IMPORTING
  IMPORTED
  SKIPPED_DUPLICATE
  FAILED
  CANCELLED
}

model ImportJobItem {
  id                String           @id @default(cuid())
  importJobId       String
  externalId        String
  title             String
  /// Genormaliseerd product (zie app/lib/import/types.ts)
  payload           Json
  /// Waarschuwingen (ontbrekende gegevens, regelgeving)
  flags             Json
  /// Prijsvoorstel op het moment van voorbeeld
  pricing           Json?
  selected          Boolean          @default(true)
  duplicateOf       String?
  status            ImportItemStatus @default(PENDING)
  attempts          Int              @default(0)
  lastError         String?
  supplierProductId String?
  shopifyProductId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  importJob       ImportJob        @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)

  @@unique([importJobId, externalId])
  @@index([importJobId, status])
}

// ---------------------------------------------------------------------------
// Synchronisatie
// ---------------------------------------------------------------------------

enum SyncMode {
  STOCK
  PRICE
  BOTH
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
}

enum SyncStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model SyncJob {
  id         String      @id @default(cuid())
  shopId     String
  supplierId String?
  mode       SyncMode
  trigger    SyncTrigger
  status     SyncStatus  @default(QUEUED)
  summary    Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Prijsregels
// ---------------------------------------------------------------------------

enum PricingScope {
  GLOBAL
  CATEGORY
  SUPPLIER
}

enum PricingStrategy {
  FIXED_MARKUP
  PERCENTAGE_MARKUP
  TARGET_MARGIN
}

enum PriceRounding {
  NONE
  END_95
  END_99
}

model PricingRule {
  id                 String          @id @default(cuid())
  shopId             String
  name               String
  isActive           Boolean         @default(true)
  /// Lagere waarde = hogere prioriteit
  priority           Int             @default(100)
  scope              PricingScope    @default(GLOBAL)
  /// Producttype/categorie waarop de regel van toepassing is (scope CATEGORY)
  category           String?
  supplierId         String?
  strategy           PricingStrategy
  /// Opslagbedrag (EUR), opslagpercentage of doelmarge (%)
  value              Decimal         @db.Decimal(12, 4)
  minimumPrice       Decimal?        @db.Decimal(12, 2)
  rounding           PriceRounding   @default(NONE)
  defaultShippingCost Decimal?       @db.Decimal(12, 2)
  importDutyPercent  Decimal?        @db.Decimal(6, 3)
  paymentFeePercent  Decimal?        @db.Decimal(6, 3)
  paymentFeeFixed    Decimal?        @db.Decimal(12, 2)
  platformFeePercent Decimal?        @db.Decimal(6, 3)
  otherCosts         Decimal?        @db.Decimal(12, 2)
  /// Btw-percentage voor deze belastingcontext; null = niet ingesteld (wordt gemeld)
  vatPercent         Decimal?        @db.Decimal(6, 3)
  pricesIncludeVat   Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([shopId, isActive, priority])
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

enum AIProvider {
  ANTHROPIC
  OPENAI
}

enum AITask {
  TITLE
  DESCRIPTION
  SEO
  TRANSLATION
  TAGS
  ALT_TEXT
  FULL
}

enum AIJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model AIJob {
  id                String      @id @default(cuid())
  shopId            String
  supplierProductId String?
  provider          AIProvider
  model             String
  task              AITask
  status            AIJobStatus @default(QUEUED)
  input             Json
  output            Json?
  error             String?
  inputTokens       Int?
  outputTokens      Int?
  createdAt         DateTime    @default(now())
  finishedAt        DateTime?

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Logboek en instellingen
// ---------------------------------------------------------------------------

enum LogLevel {
  INFO
  WARNING
  ERROR
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  actorUserId String?
  level       LogLevel @default(INFO)
  action      String
  entityType  String?
  entityId    String?
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, level])
}

model AppSetting {
  id             String   @id @default(cuid())
  shopId         String
  key            String
  /// Niet-geheime waarde
  value          Json?
  /// Geheime waarde, versleuteld (AES-256-GCM)
  valueEncrypted String?
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
}
