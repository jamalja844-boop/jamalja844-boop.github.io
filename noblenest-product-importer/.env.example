# Noblenest — voorbeeld-omgevingsvariabelen
# Kopieer naar .env en vul de waarden in. Zet .env NOOIT in Git.

# --- Shopify (wordt door `shopify app dev` automatisch gezet) ---------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://noblenest:noblenest_dev@localhost:5432/noblenest?schema=public"
# Alleen voor integratietests (aparte database, wordt geleegd tijdens tests)
TEST_DATABASE_URL="postgresql://noblenest:noblenest_dev@localhost:5432/noblenest_test?schema=public"

# --- Redis (achtergrondtaken, fase 6) ---------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Beveiliging -------------------------------------------------------------
# 32 willekeurige bytes, base64. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Hiermee worden API-sleutels (AI-providers, leveranciers) versleuteld opgeslagen.
# Bij verlies van deze sleutel zijn opgeslagen geheimen niet meer te ontsleutelen.
NOBLENEST_ENCRYPTION_KEY=

# --- Importlimieten ------------------------------------------------------------
# Maximale grootte van een uploadbestand in MB en maximaal aantal regels per bestand
NOBLENEST_MAX_UPLOAD_MB=5
NOBLENEST_MAX_ROWS=5000
# Maximale grootte van een opgehaalde feed (feed-URL) in MB
NOBLENEST_MAX_FEED_MB=20
